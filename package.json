{
  "name": "framework_automation",
  "version": "1.0.0",
  "description": "this is my personal project for testing example website local host",
  "main": "index.js",
  "scripts": {
    "test": "cypress run",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "cypress:spec": "node scripts/run-cypress-spec.cjs --headed",
    "cypress:spec:headless": "node scripts/run-cypress-spec.cjs",
    "report:merge": "mochawesome-merge cypress/results/*.json -o cypress/results/combined.json",
    "report:generate": "marge cypress/results/combined.json --reportDir cypress/results/html --inline",
    "report": "npm run report:merge && npm run report:generate"
  },
